# This file shows the shape of api/.env. The real file is generated from
# Bitwarden by scripts/render-env.sh — do not hand-edit api/.env.
# See scripts/README.md.
DATABASE_URL=postgres://user:password@localhost:5432/self-sensored
JWT_SECRET=change-me-to-at-least-32-characters
RUST_LOG=self_sensored_api=debug,tower_http=debug
API_HOST=0.0.0.0
API_PORT=3000
# Set LOG_FORMAT=json for production so logs are machine-parseable.
# Leave unset (or =pretty) for human-readable local dev output.
LOG_FORMAT=pretty

OLLAMA_API_KEY=change-me
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b-cloud
