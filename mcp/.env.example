# self-sensored-mcp configuration.
#
# Copy this file to mcp/.env (or set the variables in Claude Desktop's
# mcpServers config) and fill in real values.

# Postgres connection string. MUST point at a read-only role — the MCP server
# enforces read-only at multiple layers, but the DB role is the floor.
#
# To create the role (run once on host `four`):
#
#   CREATE ROLE self_sensored_mcp LOGIN PASSWORD '<strong password>';
#   GRANT CONNECT ON DATABASE self_sensored TO self_sensored_mcp;
#   GRANT USAGE ON SCHEMA public, nutrition TO self_sensored_mcp;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public, nutrition TO self_sensored_mcp;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public, nutrition
#     GRANT SELECT ON TABLES TO self_sensored_mcp;
#   -- Optional hardening (requires superuser):
#   REVOKE EXECUTE ON FUNCTION pg_read_file(text) FROM PUBLIC;
#
DATABASE_URL=postgres://self_sensored_mcp:CHANGEME@192.168.1.104:5432/self_sensored

# UUID of the authenticated user. All queries are scoped to this user by
# binding their UUID as $1. Find it with:
#   psql -c "SELECT id, email FROM users WHERE email = '<you>';"
MCP_USER_ID=00000000-0000-0000-0000-000000000000

# Optional — defaults shown.
# MCP_MAX_ROWS=5000
# MCP_STATEMENT_TIMEOUT_MS=5000

# Optional — tracing.
# RUST_LOG=self_sensored_mcp=info,rmcp=warn
